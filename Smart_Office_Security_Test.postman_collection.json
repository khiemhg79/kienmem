    {
      "name": "6. Lấy danh sách thiết bị - Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.length > 0) {",
              "    // Tìm thiết bị thuộc Phòng họp (Tầng 1)",
              "    var meetingDevice = jsonData.find(function(d) { return d.room === 'Phòng họp'; });",
              "    if (meetingDevice) {",
              "        pm.collectionVariables.set(\"meetingRoomDeviceId\", meetingDevice.id);",
              "    }",
              "    // Tìm thiết bị thuộc Phòng room301 (Tầng 3)",
              "    var r301Device = jsonData.find(function(d) { return d.room === 'room301'; });",
              "    if (r301Device) {",
              "        pm.collectionVariables.set(\"room301DeviceId\", r301Device.id);",
              "    }",
              "    // Tìm thiết bị thuộc Phòng nhân sự (Tầng 3)",
              "    var hrDevice = jsonData.find(function(d) { return d.room === 'Phòng nhân sự'; });",
              "    if (hrDevice) {",
              "        pm.collectionVariables.set(\"hrRoomDeviceId\", hrDevice.id);",
              "    }",
              "    pm.collectionVariables.set(\"deviceId\", jsonData[0].id);",
              "    pm.collectionVariables.set(\"deviceRoom\", jsonData[0].room);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://localhost:443/api/devices",
          "protocol": "https",
          "host": [
            "localhost"
          ],
          "port": "443",
          "path": [
            "api",
            "devices"
          ]
        },
        "description": "Admin xem được toàn bộ danh sách thiết bị trong hệ thống."
      },
      "response": []
    },
