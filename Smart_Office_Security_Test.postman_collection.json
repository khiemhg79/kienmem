    {
      "name": "2. Đăng nhập Admin (Lấy Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.accessToken) {",
              "    pm.collectionVariables.set(\"adminToken\", jsonData.accessToken);",
              "    pm.collectionVariables.set(\"userId\", jsonData.user.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"admin@smartoffice.vn\",\n    \"password\": \"Admin@123\"\n}"
        },
        "url": {
          "raw": "https://localhost:443/api/auth/login",
